{
  "expo": {
    "name": "HINCH MART",
    "slug": "hinchmart",
    "version": "1.0.28",
    "scheme": "hinchmart",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "updates": {
      "enabled": false,
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hinchmart",
      "buildNumber": "29",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Allow HINCH MART to access your camera to scan barcodes and capture product images or support attachments.",
        "NSPhotoLibraryUsageDescription": "Allow HINCH MART to access your photo library to select product photos and upload support attachments.",
        "NSPhotoLibraryAddUsageDescription": "Allow HINCH MART to save invoices and receipts to your photo library.",
        "NSLocationWhenInUseUsageDescription": "Allow HINCH MART to access your location for accurate delivery address and project site detection.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow HINCH MART to access your location for accurate delivery address and project site detection.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      },
      "config": {
        "googleMapsApiKey": "AIzaSyBQHBaFfRCHgCGKIpSm-EOsVy8dExFToeA"
      }
    },
    "android": {
      "package": "com.hinch",
      "versionCode": 29,
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBQHBaFfRCHgCGKIpSm-EOsVy8dExFToeA"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#152238"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow HINCH MART to access your location for delivery address detection."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow HINCH MART to access your camera to scan barcodes and capture product images or support attachments."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow HINCH MART to access your photo library to select product photos and upload support attachments."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-video"
    ],
    "web": {
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "6e6e7cdb-3152-4b81-8b96-f0cf293af28d"
      }
    },
    "owner": "anushabazaar2"
  }
}
